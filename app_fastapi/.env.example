# Copia este fichero como app_fastapi/.env y rellena los valores.
# Con Docker (docker compose up) casi todo viene ya resuelto en
# docker-compose.yml; ver README.md.

# ── Marca de la instalacion ──────────────────────────────────────────────────
APP_NOMBRE=Gestor de Tareas
APP_EMPRESA=Mi Empresa
# Ruta (o URL) del logo de la cabecera y del login. Pon tu imagen en
# app_fastapi/static/img/ y apunta aqui, p. ej. /static/img/mi-logo.png
APP_LOGO=/static/img/logo.svg
# Hoja de estilos extra con los colores de la marca (se carga tras main.css).
# Vacia = aspecto de serie. Ejemplo: /static/css/tema-spsil.css
APP_TEMA_CSS=
# Si la app cuelga de una portada con mas apps: su URL (boton "Aplicaciones").
APP_URL_PORTAL=

# ── Base de datos (MariaDB 10.6+) ────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_tareas
DB_PASSWORD=
DB_NAME=app_tareas
# BD de pruebas (opcional): el menu de usuario permite cambiar entre la real y
# esta. Vacia = sin entorno de pruebas.
DB_NAME_TEST=app_tareas_test
# Solo para scripts/instalar.py, si DB_USER no puede crear bases de datos:
# DB_ROOT_USER=root
# DB_ROOT_PASSWORD=

# ── Sesion (obligatorio en produccion) ───────────────────────────────────────
# Cadena larga al azar: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vacia = se genera una en cada arranque y todos tienen que volver a entrar.
SESSION_SECRET_KEY=

# ── Login ────────────────────────────────────────────────────────────────────
# local    = usuarios y contraseñas en la propia BD (scripts/usuarios.py)
# keycloak = el formulario de la app valida contra un realm de Keycloak
#            (rellena KEYCLOAK_*; el cliente necesita "Direct access grants").
# sso      = se entra en la pantalla de Keycloak y la sesion vale para todas
#            las apps del realm (rellena KEYCLOAK_* y APP_URL_PUBLICA; en el
#            cliente, Valid redirect URI = APP_URL_PUBLICA + /login/sso/).
# En keycloak y sso es de IT quien pertenezca al grupo "IT" del realm.
AUTH_MODO=local
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# Grupo de Keycloak que da entrada (y <grupo>/Admin, que administra). Vacio =
# entra cualquiera del realm. El mapper "groups" con "Full group path".
KEYCLOAK_GRUPO_APP=
KEYCLOAK_GRUPO_ADMIN_GLOBAL=IT
# sso: a donde volver tras cerrar sesion (vacio = la propia app)
SSO_URL_SALIDA=

# ── Publicacion ──────────────────────────────────────────────────────────────
# URL publica de la app (la usa el modo sso), p. ej. https://apps.empresa.com/tareas
APP_URL_PUBLICA=
# Servir la app bajo una ruta en vez de en la raiz del dominio, p. ej. /tareas
# (vacio = en la raiz). Ver app_fastapi/ruta_base.py.
APP_RUTA_BASE=

# ── Modulos opcionales (1 = activo; por defecto todos apagados) ──────────────
# Mantis: importar incidencias de MantisBT como tareas, SLA de Mantis y
#         Vigilante de incidencias nuevas.
MODULO_MANTIS=0
# Nexus: buscador/catalogo documental con fichas, relaciones y credenciales.
MODULO_NEXUS=0
# Servicios en segundo plano: Recordatorio de pausas, Vigia de carpeta y
# (con Mantis) Vigilante. Los avisos de escritorio solo salen en Windows; en
# Linux/Docker el Vigia sigue avisando por Buzon y campana.
MODULO_ESCRITORIO=0
# Conectores de entrada: traer datos de APIs externas y convertirlos en tareas.
MODULO_CONECTORES=0
# Clave con la que se cifran los tokens de los conectores (vacia = se usa
# SESSION_SECRET_KEY). Si cambia, hay que volver a escribir los tokens.
CONECTORES_CLAVE=
# Sindri: liga las empresas con los clientes de Sindri (la facturacion central)
# y le manda a facturar el tiempo real de las tareas hechas. Ver docs/SINDRI.md.
MODULO_SINDRI=0
SINDRI_URL=
# Llave creada en Sindri -> Empresa -> Integraciones (nombre "tareas").
SINDRI_LLAVE=
# sku del producto de Sindri con el que van las horas (HORA si se deja vacio).
SINDRI_PRODUCTO=

# ── Mantis (solo con MODULO_MANTIS=1) ────────────────────────────────────────
MANTIS_BASE_URL=
MANTIS_API_TOKEN=
MANTIS_MY_EMAIL=
MANTIS_MY_USERNAME=
# Cuenta de Mantis de un bot/IA que abre incidencias sola (opcional): sus
# incidencias se cuentan aparte en el desglose de origen del SLA.
MANTIS_REPORTERO_IA=

# ── API externa ──────────────────────────────────────────────────────────────
# Clave "maestra" opcional (acceso a todo, firma como "API"). Mejor crear
# tokens con dueño en Configuracion -> API.
API_IMPORT_TOKEN=

# ── Otros ────────────────────────────────────────────────────────────────────
# Ruta a mysqldump/mariadb-dump si "Hacer backup ahora" no lo encuentra solo.
MYSQLDUMP_PATH=
# 1 = no arrancar los servicios en segundo plano en este proceso aunque el
# modulo este activo (util con varios procesos de la app a la vez).
APP_TAREAS_SIN_ESCRITORIO=0
