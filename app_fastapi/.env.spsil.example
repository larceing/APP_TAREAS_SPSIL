# Configuracion de la app para SPSIL. Copia este fichero como app_fastapi/.env.
# Las variables de BD y sesion vienen del .env de la raiz (docker-compose);
# aqui solo marca, ruta, login y modulos.

APP_NOMBRE=Gestor de Tareas SPSIL
APP_EMPRESA=SPSIL
APP_LOGO=/static/img/spsil-logo.webp

# La app vive en https://spsil.luiscontacto03.com/tareas/ (la portada de
# plataforma/ reparte por rutas). Ver app_fastapi/ruta_base.py.
APP_RUTA_BASE=/tareas
APP_URL_PUBLICA=https://spsil.luiscontacto03.com/tareas

# Login unico con Keycloak (plataforma/): se entra en la pantalla de Keycloak
# y vale para todas las apps. Es de IT quien este en el grupo "IT" del realm.
AUTH_MODO=sso
KEYCLOAK_ISSUER=https://spsil.luiscontacto03.com/auth/realms/spsil
KEYCLOAK_CLIENT_ID=app-tareas
# Keycloak -> realm spsil -> Clients -> app-tareas -> Credentials. No lo pegues en chats.
KEYCLOAK_CLIENT_SECRET=
# A donde volver al cerrar sesion (la portada)
SSO_URL_SALIDA=https://spsil.luiscontacto03.com/

# Solo el nucleo (tableros, agenda, wiki, Buzon, muros, SLA, API).
MODULO_MANTIS=0
MODULO_NEXUS=0
MODULO_ESCRITORIO=0
MODULO_CONECTORES=0
