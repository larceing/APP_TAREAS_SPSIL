# Configuracion de la app para la demo de SPSIL. Copia este fichero como
# app_fastapi/.env. Las variables de BD y sesion vienen del .env de la raiz
# (docker-compose); aqui solo marca, login y modulos.

APP_NOMBRE=Gestor de Tareas SPSIL
APP_EMPRESA=SPSIL
# Cuando tengamos el logo: app_fastapi/static/img/spsil-logo.png y
# APP_LOGO=/static/img/spsil-logo.png
APP_LOGO=/static/img/logo.svg

# Demo: usuarios locales (scripts/usuarios.py). Keycloak mas adelante si hace falta.
AUTH_MODO=local

# Demo: solo el nucleo (tableros, agenda, wiki, Buzon, muros, SLA, API).
MODULO_MANTIS=0
MODULO_NEXUS=0
MODULO_ESCRITORIO=0
MODULO_CONECTORES=0
