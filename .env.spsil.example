# Demo de SPSIL. Copia este fichero como .env (raiz del repo) y cambia TODAS
# las contraseñas. Genera cada secreto en el propio servidor, p. ej.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# No pegues estos valores en chats ni correos.

# Base + capa SPSIL (red "proxy_default" del proxy compartido, sin puertos propios)
COMPOSE_FILE=docker-compose.yml:docker-compose.spsil.yml
COMPOSE_PROJECT_NAME=spsil-tareas
# MariaDB en contenedor propio de este proyecto
COMPOSE_PROFILES=bd-docker

DB_HOST=db
DB_PORT=3306
DB_USER=app_tareas
DB_PASSWORD=
DB_NAME=app_tareas_spsil
DB_NAME_TEST=app_tareas_spsil_test
DB_ROOT_USER=root
DB_ROOT_PASSWORD=

# Primer arranque: administrador y datos de ejemplo (demo = 1)
INSTALAR_ADMIN=admin
INSTALAR_ADMIN_PASSWORD=
INSTALAR_DEMO=1

SESSION_SECRET_KEY=

