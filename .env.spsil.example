# Demo de SPSIL. Copia este fichero como .env (raiz del repo) y cambia TODAS
# las contraseñas. Genera cada secreto en el propio servidor, p. ej.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# No pegues estos valores en chats ni correos.

# bd-docker = MariaDB en contenedor propio; https = Caddy con certificado.
# Con un MariaDB ya existente quita bd-docker y rellena DB_HOST/DB_PORT.
# Con un proxy ya existente (nginx, IIS...) quita https.
COMPOSE_PROFILES=bd-docker,https

# Dominio publico de la demo (su DNS debe apuntar a este servidor)
DOMINIO=tareas-demo.spsil.example
# Correo para avisos de Let's Encrypt (opcional)
CORREO_TLS=

DB_HOST=db
DB_PORT=3306
DB_USER=app_tareas
DB_PASSWORD=
DB_NAME=app_tareas_spsil
DB_NAME_TEST=app_tareas_spsil_test
DB_ROOT_USER=root
DB_ROOT_PASSWORD=

# Primer arranque: administrador y datos de ejemplo (demo = 1)
INSTALAR_ADMIN=admin
INSTALAR_ADMIN_PASSWORD=
INSTALAR_DEMO=1

SESSION_SECRET_KEY=

APP_PUERTO=8000
