# Proxy HTTPS delante de la app (docker-compose.spsil.yml, perfil "https").
# Caddy pide y renueva solo el certificado: el DNS de DOMINIO tiene que
# apuntar a este servidor y los puertos 80 y 443 estar abiertos.
{
	email {$CORREO_TLS}
}

{$DOMINIO} {
	encode gzip
	# Subidas de adjuntos/imagenes de la wiki
	request_body {
		max_size 50MB
	}
	reverse_proxy app:8000
}
